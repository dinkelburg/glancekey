{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "glancekey-relay",
  // DinkelWorks, the account that owns dinkelworks.nl.
  "account_id": "23f8ca529032473a25c2ea485fc5a7ab",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [{ "name": "MACHINES", "class_name": "Machine" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Machine"] }],
  "routes": [{ "pattern": "glancekey.dinkelworks.nl", "custom_domain": true }],
  "observability": { "enabled": true }
}
