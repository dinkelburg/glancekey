{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "glancekey-relay",
  // DinkelWorks, the account that owns glancekey.com and dinkelworks.nl.
  "account_id": "23f8ca529032473a25c2ea485fc5a7ab",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [
      { "name": "MACHINES", "class_name": "Machine" },
      // The iPhones' lock screen cards, one per iPhone.
      { "name": "CARDS", "class_name": "Card" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Machine"] },
    { "tag": "v2", "new_sqlite_classes": ["Card"] }
  ],
  // The apps use relay.glancekey.com. Installs and pairings from before 2026-10-26 still use
  // glancekey.dinkelworks.nl; both reach the same Durable Objects, so they work together.
  "routes": [
    { "pattern": "relay.glancekey.com", "custom_domain": true },
    { "pattern": "glancekey.dinkelworks.nl", "custom_domain": true }
  ],
  // Notifications through Apple's push service (src/index.ts). The key itself is a secret:
  // npx wrangler secret put APNS_KEY < AuthKey_<APNS_KEY_ID>.p8
  "vars": {
    // "GlanceKey push" in Ruben's Apple Developer account (Sandbox & Production, team scoped)
    "APNS_KEY_ID": "55K782WVH5",
    "APNS_TEAM_ID": "U78YQGE72M",
    "APNS_TOPIC": "nl.dinkelworks.glancekey",
    // What the App Store app allows without the subscription (GET /v1/limits); null is no limit. The app only
    // applies them to computers on this relay, so a relay of your own has none.
    "FREE_LIMITS": { "computers": 2, "perDay": 15 }
  },
  "observability": { "enabled": true }
}
