{
  "$schema": "../node_modules/wrangler/config-schema.json",
  // Sends the site's other addresses to https://www.glancekey.com, keeping the path.
  "name": "glancekey-redirect",
  // DinkelWorks, the account that owns glancekey.com and dinkel.works.
  "account_id": "23f8ca529032473a25c2ea485fc5a7ab",
  "main": "index.js",
  "compatibility_date": "2026-10-01",
  "routes": [
    { "pattern": "glancekey.com", "custom_domain": true },
    // The site's first address
    { "pattern": "glancekey.dinkel.works", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false,
  // Like the site itself: no request logs.
  "observability": { "enabled": false }
}
