{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The landing page: static files only, no Worker code.
  "name": "glancekey-site",
  // DinkelWorks, the account that owns dinkel.works.
  "account_id": "23f8ca529032473a25c2ea485fc5a7ab",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "glancekey.dinkel.works", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  // The site promises no tracking: no request logs either.
  "observability": { "enabled": false }
}
